{
 "$description": "Ari 2 B+ tokens, locked by Owner on Oct 24 2026. Supersede the S2 Lamp & Dawn palette and Instrument Sans for the B+ shell (b.html, src/b). src/b/tokens.css is generated from this file by scripts/tokens/gen_bplus.py. No green, no gradients, no glows.",
 "palette": {
  "paper": "#F7F6EF", "card": "#FFFFFF", "well": "#EFEDE3", "ink": "#1B1B2E", "inkSoft": "#4D4C6B",
  "nightPass": "#2A2946", "nightWell": "#1F1E36", "lavender": "#C2C1EB", "salmon": "#F7866D", "dawn": "#FAF79B",
  "mist": "#B9B8DC", "nightBg": "#121220", "nightLine": "#3D3C5E", "paperLine": "#DAD8CC"
 },
 "$roles": "Role tokens per theme. Values name a palette entry. inkSoft is added for quiet text on light grounds (7.6:1 on paper); nightWell for the draft box inside a pass; the two lines are decorative dividers only.",
 "theme": {
  "light": {
   "bg": "paper", "card": "card", "well": "well", "text": "ink", "text-soft": "inkSoft",
   "pass": "nightPass", "pass-well": "nightWell", "pass-text": "paper", "pass-soft": "mist",
   "chip-ready": "lavender", "chip-needs": "salmon", "chip-due": "dawn", "on-chip": "ink",
   "btn": "ink", "on-btn": "paper", "border": "ink", "line": "paperLine", "focus": "ink", "pill": "ink", "on-pill": "paper"
  },
  "dark": {
   "bg": "nightBg", "card": "nightPass", "well": "nightWell", "text": "paper", "text-soft": "mist",
   "pass": "nightPass", "pass-well": "nightWell", "pass-text": "paper", "pass-soft": "mist",
   "chip-ready": "lavender", "chip-needs": "salmon", "chip-due": "dawn", "on-chip": "ink",
   "btn": "paper", "on-btn": "ink", "border": "mist", "line": "nightLine", "focus": "lavender", "pill": "paper", "on-pill": "ink"
  }
 },
 "$contrast": "Text pairs checked by gen_bplus.py --check in both themes: >= 4.5:1. Boundaries (border, focus) >= 3:1 on bg and card.",
 "textPairs": [["text", "bg"], ["text", "card"], ["text", "well"], ["text-soft", "bg"], ["text-soft", "card"], ["text-soft", "well"],
  ["pass-text", "pass"], ["pass-soft", "pass"], ["pass-text", "pass-well"], ["pass-soft", "pass-well"],
  ["on-chip", "chip-ready"], ["on-chip", "chip-needs"], ["on-chip", "chip-due"], ["on-btn", "btn"], ["on-pill", "pill"], ["pass", "pass-text"]],
 "boundaryPairs": [["border", "bg"], ["border", "card"], ["focus", "bg"], ["focus", "card"]],
 "font": { "family": ["Plus Jakarta Sans", "system-ui", "sans-serif"] },
 "fontSize": { "1": "0.75rem", "2": "0.875rem", "3": "1rem", "4": "1.125rem", "5": "1.375rem", "6": "1.75rem" },
 "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px" },
 "radius": { "s": "8px", "m": "12px", "l": "20px", "xl": "28px", "pill": "9999px" },
 "tap": "48px",
 "motion": {
  "quick": "160ms", "base": "240ms", "slow": "280ms", "done": "720ms",
  "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)", "ease-in-out": "cubic-bezier(0.45, 0, 0.55, 1)",
  "$note": "Everything stays under 300 ms except the done moment. prefers-reduced-motion turns every duration to 1ms."
 }
}
