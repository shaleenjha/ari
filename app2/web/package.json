{
  "name": "ari-app2-web",
  "private": true,
  "version": "18.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert \"@design|@verify\"",
    "verify:mobile": "PW_NO_LIVE=1 playwright test --grep @verify --project=webkit-390 --project=chromium-412 --workers=2 --retries=0",
    "verify:summary": "node scripts/verify-summary.mjs",
    "lint:design": "playwright test --grep @design",
    "lint:design:static": "node scripts/design-lint/static.mjs",
    "lint:query": "node scripts/query-lint/query-lint.mjs",
    "lint:slop": "npm run lint:design:static && npm run lint:query"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
