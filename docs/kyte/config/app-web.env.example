VITE_ARI_SUPABASE_KEY=<publishable key>
VITE_ARI_GOOGLE_CLIENT_ID=<google oauth client id>.apps.googleusercontent.com
VITE_ARI_WORKSPACE_ID=<app.workspaces id>
