# Kyte worker and scripts (scripts/*.py) outside Hark. Copy to a private file, never commit it.
# Inside Hark these came from saved bindings: the proxy injected the database bearer and the Google credentials.

# --- Supabase (required) ---
ARI_SB_URL=https://<your-project-ref>.supabase.co
ARI_SB_APIKEY=<your project's publishable key, sb_publishable_...>

# Option A (what prod used): a long-lived JWT whose role claim is ari_worker, in a private file.
ARI_SB_JWT_FILE=/path/to/private/ari_worker.jwt

# Option B (R7, tested on staging only): 1-hour tokens from the ari-worker-token broker. Leave ARI_SB_JWT_FILE unset.
# ARI_WORKER_BROKER=1
# ARI_BROKER_URL=https://<your-project-ref>.functions.supabase.co/ari-worker-token
# ARI_WORKER_CALLER_FILE=/path/to/private/broker_caller_secret
# ARI_WORKER_UID=<auth user id of the worker user>

# --- Seller settings (required for copy_check.py and scan_heartbeat.py) ---
ARI_SELLER_CONFIG=/path/to/private/seller.private.json

# --- Optional ---
# ARI_SB_CACHE_DIR=/path/to/private/sbcache     # sync base cache (default work/state/sbcache)
# ARI_SB_FULL=1                                  # force a full sync read this run
# ARI_ASSUMPTIONS_STORE=1                        # G12: store assumptions this run (scripts/assumptions_store.conf is the switch)
# ARI_RELAY_ON=1                                 # legacy Claude relay check
# ARI_PRECHECK_LEGACY_GMAIL=1                    # old Gmail path in the precheck

# --- Maintenance only (restore drill, manual backup) ---
# ARI_PROJECT_REF=<your-project-ref>
# ARI_MAINT=1
# ARI_MAINT_KEY_NAME=<named secret key for maintenance>
# ARI_OFFSITE_KEY_FILE=/path/to/private/offsite_recipient_key.pem
# ARI_ALLOW_LEGACY_KEY=1

# --- Deploy and repo ---
# ARI_BASE_FIX='<reason>'                        # required to deploy a changed web/ops.html (frozen file)
# VERCEL_TOKEN=<token>                           # deploy_web.py relied on Hark injecting this header; add it yourself outside Hark
# KEEL_DIR=/path/to/private/keel                 # where scrub_map.json, names.json, dict_words.txt live
# KEEL_EXPORT=/path/to/private/keel/export       # export tree git_sync.sh commits from

# Google (Sheets, Gmail read, Gmail send to yourself, Calendar, Drive) goes through the gws CLI, authenticated separately:
#   gws auth login   (scopes: spreadsheets, gmail.readonly, gmail.send, calendar.events, drive.file)
