# Supabase edge function secrets (Project Settings > Edge Functions > Secrets). Names only; never commit values.
# SUPABASE_URL, SUPABASE_DB_URL, SUPABASE_SECRET_KEYS and SUPABASE_PUBLISHABLE_KEYS are injected by Supabase.

# ari-push (web push)
#   reads the VAPID private key from Vault (ari_vapid_private_jwk) and the public key from app_config.vapid_public_key
EXPO_ACCESS_TOKEN=            # only for native Expo push; leave empty for web push only

# ari-backup (nightly backup)
ARI_BACKUP_HOOK=              # 64 hex chars (openssl rand -hex 32); must equal Vault secret ari_backup_hook_secret
OFFSITE_CERT_PEM=             # optional, staging only: recipient cert override (prod uses the certs built into the function)

# ari-gmail-oauth and ari-gmail-ingest (Gmail read)
ARI_GMAIL_CLIENT_ID=          # Google Cloud OAuth client (Web application)
ARI_GMAIL_CLIENT_SECRET=
ARI_GMAIL_ALLOW=              # the one mailbox allowed to connect

# Named secret keys (create under API Keys, type secret), read through SUPABASE_SECRET_KEYS:
#   ari_push, ari_backup, ari_gmail_oauth, ari_gmail_ingest   (pending R7 versions of the four live functions)
#   ari_worker_token                                          (broker)
#   ari_ai, ari_gmail_push                                    (AI layer)
# If SUPABASE_SECRET_KEYS is not injected, set ARI_SK_<NAME> instead (e.g. ARI_SK_ARI_AI).

# ari-worker-token (R7 broker, optional)
ARI_WORKER_CALLER_SECRET=     # random; the worker sends it as x-ari-worker-caller
ARI_WORKER_EMAIL=             # worker Auth user
ARI_WORKER_PASSWORD=
ARI_WORKER_UID=
# ARI_BROKER_DISABLED=1       # kill switch

# kyte-ai (and its alias ari-ai), optional AI layer
ANTHROPIC_API_KEY=
PARALLEL_API_KEY=             # fact check
ARI_PUBLISHABLE_KEY=          # only if SUPABASE_PUBLISHABLE_KEYS is not injected
ARI_APP_ORIGINS=https://<your-app-domain>
XAI_API_KEY=                  # deep research only
BRAVE_SEARCH_API_KEY=         # import LinkedIn URL waterfall step 1, optional
LEMLIST_API_KEY=              # import waterfall step 2, optional
